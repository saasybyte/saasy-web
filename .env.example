# saasy-web environment
# Copy to .env for local dev, or to .env.production (with your deployed URLs)
# for production builds. VITE_ values are baked into the JS bundle at build
# time and are therefore public.

VITE_CORE_URL=http://localhost:8082
VITE_EDGE_URL=http://localhost:8080
VITE_SIGNAL_URL=ws://127.0.0.1:3000/ws/session
